generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  nik       String
  instansi  String
  keperluan String
  photoUrl  String?
  checkIn   DateTime @default(now())
  checkOut  DateTime?
  token     String?  // The QR token used to check in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QrToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiredAt DateTime
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}
